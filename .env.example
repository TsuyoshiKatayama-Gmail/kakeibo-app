# Claude API キー（https://console.anthropic.com/ で取得）
# このファイルをコピーして .env を作成し、実際のキーを設定してください:
#   cp .env.example .env
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# バックエンドの待ち受けポート（省略時は 3001。多くのホスティングでは自動設定される）
PORT=3001

# 簡易アクセス制限用のパスワード（任意）
# 設定するとサイト全体が Basic 認証で保護され、正しいパスワードを知る人だけが利用できる。
# 公開デプロイ時は必ず設定して、第三者による API キー(=課金)の無断利用を防ぐことを推奨。
# 未設定の場合は認証なし（誰でも利用可）になる。
APP_PASSWORD=
